{
  "name": "Halo",
  "appId": "com.halo.orgmock",
  "dataFolderName": "halo-org-mock",
  "deepLinkScheme": "halo-org-mock",
  "version": "1.0.0",
  "updateConfig": { "provider": "disabled" },
  "authProviders": [
    {
      "type": "custom",
      "displayName": { "en": "Custom API" },
      "description": { "en": "Configure a compatible API" },
      "icon": "key",
      "iconBgColor": "#da7756",
      "recommended": true,
      "builtin": true,
      "enabled": true
    },
    {
      "type": "example-cloud",
      "displayName": { "en": "Example Cloud" },
      "description": { "en": "Models for members of Example Org" },
      "icon": "cloud",
      "iconBgColor": "#0ea5e9",
      "recommended": false,
      "enabled": true,
      "path": "./model-account-provider.mjs"
    }
  ],
  "enterpriseIdentity": {
    "provider": "./provider.mjs",
    "name": "Example Org",
    "toolCredentials": [
      {
        "toolId": "example-org.mock-tool",
        "capability": "mail",
        "audience": "mail-example",
        "env": "EXAMPLE_ORG_MOCK_TOKEN"
      }
    ],
    "modelAccounts": [
      { "aiSourceType": "example-cloud", "capability": "model", "audience": "example-cloud-model" }
    ]
  }
}
