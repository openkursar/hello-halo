{
  "$ref": "#/definitions/approval",
  "definitions": {
    "approval": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "storyId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "semanticHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "decidedAt": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "version",
        "storyId",
        "semanticHash",
        "decision",
        "reviewer",
        "decidedAt"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
