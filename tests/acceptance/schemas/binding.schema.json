{
  "$ref": "#/definitions/binding",
  "definitions": {
    "binding": {
      "type": "object",
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "evidence": {
          "type": "string",
          "enum": [
            "ui",
            "app-e2e",
            "integration",
            "live-model",
            "external",
            "manual"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "none",
            "scripted",
            "live"
          ]
        },
        "variant": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "required": [
        "caseId",
        "evidence",
        "mode"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
