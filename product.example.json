{
  "$schema": "./product.schema.json",
  "name": "Halo",
  "appId": "com.halo.app",
  "dataFolderName": "halo",
  "version": "1.0.0",
  "updateConfig": {
    "provider": "github",
    "owner": "openkursar",
    "repo": "hello-halo"
  },
  "authProviders": [
    {
      "type": "claude",
      "displayName": {
        "en": "Claude",
        "zh-CN": "Claude"
      },
      "recommended": true,
      "description": {
        "en": "Claude Pro/Max, login with claude.ai account",
        "zh-CN": "Claude Pro/Max, 使用 claude.ai 账号登录"
      },
      "icon": "log-in",
      "iconBgColor": "#D97757",
      "builtin": true,
      "enabled": true
    },

    {
      "type": "claude-cli",
      "displayName": {
        "en": "Claude Code CLI",
        "zh-CN": "Claude Code CLI"
      },
      "recommended": false,
      "description": {
        "en": "The bundled official Claude Code CLI signs in and sends requests, behaving exactly like the official client; switch to this when the regular Claude login stops working",
        "zh-CN": "由内置官方 Claude Code CLI 登录并发送请求，行为与官方客户端完全一致；普通 Claude 登录失效时可改用此方式"
      },
      "icon": "terminal",
      "iconBgColor": "#D97757",
      "builtin": true,
      "enabled": true,
      "setupHidden": true,
      "platforms": ["darwin"]
    },

    {
      "type": "custom",
      "displayName": {
        "en": "Custom API",
        "zh-CN": "自定义 API"
      },
      "description": {
        "en": "Claude / OpenAI compatible",
        "zh-CN": "兼容 Claude / OpenAI"
      },
      "icon": "key",
      "iconBgColor": "#da7756",
      "recommended": false,
      "builtin": true,
      "enabled": true,
      "docs": {
        "url": "https://hello-halo.cc/docs/getting-started/setup-ai.html",
        "label": {
          "en": "Don't know how to get it? View tutorial",
          "zh-CN": "不知道如何获取？查看教程"
        }
      }
    },
    {
      "type": "github-copilot",
      "displayName": {
        "en": "GitHub Copilot",
        "zh-CN": "GitHub Copilot"
      },
      "description": {
        "en": "Login with GitHub, use Copilot models",
        "zh-CN": "GitHub 登录，使用 Copilot 模型"
      },
      "icon": "github",
      "iconBgColor": "#24292e",
      "recommended": false,
      "builtin": true,
      "enabled": true
    }
  ]
}
