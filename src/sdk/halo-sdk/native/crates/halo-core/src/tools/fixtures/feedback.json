  {
    "name": "edit-preconditions",
    "files": {
      "file.txt": "one one"
    },
    "steps": [
      {
        "tool": "Edit",
        "input": {
          "file_path": "file.txt",
          "old_string": "one",
          "new_string": "two"
        },
        "expected": {
          "content": "Edit needs a recorded Read of this file. Read the target, then prepare old_string from the returned source text and retry.",
          "isError": true
        }
      },
      {
        "tool": "Read",
        "input": {
          "file_path": "file.txt"
        },
        "expected": {
          "content": "1\tone one\n",
          "isError": false
        }
      },
      {
        "tool": "Edit",
        "input": {
          "file_path": "file.txt",
          "old_string": "one",
          "new_string": "two"
        },
        "expected": {
          "content": "The edit is ambiguous: old_string occurs 2 times. Include enough adjacent source text to select one occurrence, or set replace_all=true if every occurrence should change.\nold_string: one",
          "isError": true
        }
      },
      {
        "tool": "Edit",
        "input": {
          "file_path": "file.txt",
          "old_string": "one",
          "new_string": "two",
          "replace_all": true
        },
        "expected": {
          "content": "Successfully edited <root>/file.txt (2 replacements).",
          "isError": false,
          "metadata": {
            "file_path": "<root>/file.txt",
            "replacements": 2
          }
        }
      }
    ],
    "finalFiles": {
      "file.txt": "two two"
    }
  },
