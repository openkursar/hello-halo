  {
    "name": "search-feedback",
    "files": {
      "a.txt": "needle\nother\nneedle\n"
    },
    "steps": [
      {
        "tool": "Glob",
        "input": {},
        "expected": {
          "content": "pattern is required",
          "isError": true
        }
      },
