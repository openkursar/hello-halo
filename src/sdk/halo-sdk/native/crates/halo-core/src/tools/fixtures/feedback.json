        "expected": {
          "content": "No files matched pattern \"*.none\" in <root>",
          "isError": false
        }
      },
      {
        "tool": "Glob",
        "input": {
          "pattern": "*",
          "path": "absent"
        },
        "expected": {
          "content": "Directory not found: <root>/absent",
          "isError": true
        }
      },
      {
        "tool": "Glob",
        "input": {
          "pattern": "*",
          "path": "a.txt"
        },
        "expected": {
          "content": "Not a directory: <root>/a.txt",
          "isError": true
        }
      },
      {
        "tool": "Grep",
        "input": {},
        "expected": {
          "content": "pattern is required",
          "isError": true
        }
      },
      {
        "tool": "Grep",
        "input": {
          "pattern": "missing"
        },
        "expected": {
          "content": "No matches found for pattern \"missing\" in <root>. Check the pattern syntax (ripgrep regex), broaden the pattern, or search a different path.",
          "isError": false
        }
      },
      {
        "tool": "Grep",
        "input": {
          "pattern": "needle",
          "output_mode": "content",
          "head_limit": 1
        },
        "expected": {
          "content": "<root>/a.txt:1:needle\n\n[Showing lines 1-1 of 2 matching lines. Use offset=1 to continue, or narrow the search with a more specific pattern, glob, type, or path.]",
          "isError": false
        }
      },
      {
        "tool": "Grep",
        "input": {
          "pattern": "needle",
          "output_mode": "content",
          "offset": 1,
          "head_limit": 1
        },
        "expected": {
          "content": "<root>/a.txt:3:needle\n\n[Showing lines 2-2 of 2 matching lines. Use offset=2 to continue, or narrow the search with a more specific pattern, glob, type, or path.]",
          "isError": false
        }
      }
    ],
    "finalFiles": {
